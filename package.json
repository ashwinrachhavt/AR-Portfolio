{
  "name": "portfolio-website",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/publish-writing.mjs build && next build",
    "content:build": "node scripts/publish-writing.mjs build",
    "content:import": "node --env-file-if-exists=.env scripts/publish-writing.mjs import",
    "content:notion": "node --experimental-strip-types --env-file-if-exists=.env scripts/publish-writing.mjs notion",
    "test": "node --experimental-strip-types --test src/lib/*.test.mjs src/lib/workflow/*.test.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@notionhq/client": "^2.3.0",
    "@vercel/analytics": "^1.5.0",
    "ai": "^7.0.107",
    "autoprefixer": "10.4.21",
    "classnames": "^2.5.1",
    "eve": "^0.63.0",
    "framer-motion": "^12.23.12",
    "next": "16.3.5",
    "notion-to-md": "^3.1.9",
    "postcss": "8.5.6",
    "react": "^19.2.0",
    "react-animated-numbers": "^1.1.1",
    "react-dom": "^19.2.0",
    "react-feather": "^2.0.10",
    "react-markdown": "^10.1.0",
    "react-type-animation": "^3.2.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.4",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.5.1"
}
