USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
USER_LLM_MODEL=openai/gpt-4.1-mini
AI_GATEWAY_API_KEY=your-ai-gateway-key-here
OPENAI_API_KEY=your-openai-api-key-here
NOTION_API_KEY=your-notion-api-key-here
NOTION_DATABASE_ID=your-notion-database-id-here

# Public writing integrations. Leave unpublished sources empty.
SITE_URL=https://ashwinrachha.vercel.app
SUBSTACK_PUBLICATION_URL=
SUBSTACK_PROFILE_URL=https://substack.com/@ashwinrachha
HASHNODE_PUBLICATION_URL=

# Career Fit Navigator. Examples and keyword mapping work without a provider.
# Venice currently promotes free Jev access. Create an Inference Only key with
# USD spending DISABLED at https://venice.ai/settings/api (no card or top-up).
# Keep live false until this account's free access and key limit are verified.
# Each request checks the model catalog for zero input/output USD prices.
# Missing/nonzero pricing uses an explicit keyword preview; no provider fallback.
CAREER_FIT_PROVIDER=venice
VENICE_API_KEY=
CAREER_FIT_LIVE_ENABLED=false
# Legacy option: CAREER_FIT_PROVIDER=vercel uses AI_GATEWAY_API_KEY or OIDC;
# it still requires zero catalog prices and stops before 2026-09-25 UTC.
