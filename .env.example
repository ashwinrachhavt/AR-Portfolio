# Career Fit Navigator. Examples and keyword mapping work without a provider.
# Live analysis calls Jev (typesafe/jev-1.13), a TypeSafe decision model served
# directly by OpenRouter: POST /api/alpha/decisions, billed per input token
# ($0.042/M; output tokens free). Set both values to enable it.
CAREER_FIT_LIVE_ENABLED=false
OPENROUTER_API_KEY=
